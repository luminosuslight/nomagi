# Host port for Gitea's web UI and git HTTP(S) endpoint
GITEA_HTTP_PORT=55001

# Public URL Gitea uses when generating clone/push links
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:55001/

# File ownership inside the container (match your host user for bind mounts)
GITEA_UID=1000
GITEA_GID=1000

# Browser CORS for isomorphic-git
# Git smart HTTP uses GITEA_CORS_ORIGIN (single origin only in Gitea 1.23)
GITEA_CORS_ORIGIN=https://notes.luminosus.org
GITEA_CORS_ALLOW_DOMAIN=https://notes.luminosus.org,https://notes-dev.luminosus.org
