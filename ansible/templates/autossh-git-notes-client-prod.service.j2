[Unit]
Description=AutoSSH reverse tunnel for Git Notes Client production (port {{ prod_port }})
After=network.target git-notes-client.service

[Service]
User={{ service_user }}
Group={{ service_user }}
ExecStart=/usr/bin/autossh -M 0 -N -T -R {{ prod_port }}:127.0.0.1:{{ prod_port }} {{ ssh_user }}@{{ ssh_host }} -o ExitOnForwardFailure=yes -o ServerAliveInterval=60 -o ServerAliveCountMax=3
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
Type=simple

[Install]
WantedBy=multi-user.target
